<?xml version="1.0"?>
<launch>
  <!--
    SimEnv FAST-LIO2 Mapping Launch
    ================================
    Assumes:
      - Gazebo + SimEnv (auto.sh) is already running with sensors publishing.
      - FAST_LIO package is cloned into SimEnv/src/ (SimEnv is the catkin workspace root).
      - The scan_to_pointcloud2 adapter node is providing /scan_pointcloud2.

    Does NOT start Gazebo, the robot controller, or building control.

    Usage:
      # Start SimEnv first:
      ENABLE_POINTCLOUD_CONVERTER=0 ./auto.sh
      # In another terminal, launch FAST-LIO2 mapping:
      roslaunch simenv_fast_lio2_integration simenv_fast_lio2_mapping.launch
  -->

  <!-- PointCloud adapter: /scan (PointCloud) -> /scan_pointcloud2 (PointCloud2) -->
  <arg name="enable_adapter" default="true"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="pointcloud2_topic" default="/scan_pointcloud2"/>

  <!-- FAST-LIO2 parameters -->
  <arg name="lidar_topic" default="/scan_pointcloud2"/>
  <arg name="imu_topic" default="/livox/imu"/>
  <arg name="use_trunk_imu" default="false"/>
  <arg name="fast_lio_config" default="$(find simenv_fast_lio2_integration)/config/simenv_mid360.yaml"/>
  <arg name="rviz" default="false"/>
  <arg name="save_pcd" default="true"/>

  <!-- PointCloud adapter node -->
  <node if="$(arg enable_adapter)" pkg="simenv_fast_lio2_integration"
        type="scan_to_pointcloud2.py" name="scan_to_pointcloud2" output="screen">
    <param name="scan_topic" value="$(arg scan_topic)"/>
    <param name="output_topic" value="$(arg pointcloud2_topic)"/>
  </node>

  <!-- FAST-LIO2 node (from external FAST_LIO package) -->
  <!-- Load YAML config at root namespace (FAST-LIO2 uses public NodeHandle, not private) -->
  <rosparam file="$(arg fast_lio_config)" command="load"/>
  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen"/>

  <!-- Bridge: map → camera_init static TF.
       FAST-LIO2 creates its own ``camera_init`` frame, disconnected from the
       Gazebo ``map → odom → base`` tree.  This node looks up ``map → laser_livox``
       and publishes the same transform as a static TF ``map → camera_init``,
       connecting the two trees so that /Odometry can be visualised in the
       world frame. -->
  <node pkg="simenv_fast_lio2_integration"
        type="map_to_camera_init_bridge.py" name="map_to_camera_init_bridge"
        output="screen" respawn="false"/>

  <!-- RViz (optional) -->
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find simenv_fast_lio2_integration)/config/fast_lio2.rviz"/>

</launch>

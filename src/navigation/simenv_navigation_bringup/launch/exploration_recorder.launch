<launch>
  <!-- Exploration Result Recorder launch.
       Launches the recorder + 2D map projector.
       All recording params inherit defaults from the recorder node.

       Usage:
         roslaunch simenv_navigation_bringup exploration_recorder.launch \
           output_dir:=/path/to/output run_id:=my_run
  -->
  <arg name="output_dir" default=""/>
  <arg name="run_id" default="unknown"/>
  <arg name="max_sim_time" default="1800.0"/>
  <arg name="finish_quiet_time" default="60.0"/>
  <arg name="map_stable_wait" default="5.0"/>
  <arg name="minimal_map_validation" default="false"/>
  <arg name="stop_after_map_updates" default="3"/>
  <arg name="trajectory_pose_topic" default="/navigation/state_estimation"/>
  <arg name="trajectory_target_frame" default="map"/>
  <!-- 2.0 m/s is above the 0.8 m/s planner limit but below known divergence. -->
  <arg name="route_max_speed_mps" default="2.0"/>
  <arg name="route_max_step_m" default="2.0"/>
  <arg name="transform_timeout" default="0.05"/>

  <!-- 2D map projector: terrain point cloud -> OccupancyGrid -->
  <node pkg="simenv_navigation_bridge" type="terrain_to_2d_map.py"
        name="terrain_to_2d_map" output="screen" launch-prefix="/usr/bin/python3">
    <param name="input_cloud" value="/navigation/terrain_map"/>
    <param name="output_grid" value="/navigation/occupancy_grid_2d"/>
    <param name="resolution" value="0.10"/>
    <param name="width_m" value="$(optenv BUILDING_WIDTH 20.0)"/>
    <param name="height_m" value="$(optenv BUILDING_LENGTH 36.0)"/>
    <param name="center_x" value="$(optenv ROBOT_X 0.0)"/>
    <param name="center_y" value="$(optenv ROBOT_Y 2.3)"/>
    <param name="frame_id" value="map"/>
    <param name="publish_rate" value="2.0"/>
    <param name="min_z" value="-0.3"/>
    <param name="max_z" value="1.2"/>
    <param name="occupied_threshold" value="2"/>
  </node>

  <!-- Main exploration recorder -->
  <node pkg="simenv_navigation_bridge" type="exploration_result_recorder.py"
        name="exploration_result_recorder" output="screen" launch-prefix="/usr/bin/python3"
        required="true">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="run_id" value="$(arg run_id)"/>
    <param name="max_sim_time" value="$(arg max_sim_time)"/>
    <param name="finish_quiet_time" value="$(arg finish_quiet_time)"/>
    <param name="map_stable_wait" value="$(arg map_stable_wait)"/>
    <param name="trajectory_pose_topic" value="$(arg trajectory_pose_topic)"/>
    <param name="trajectory_target_frame" value="$(arg trajectory_target_frame)"/>
    <param name="route_max_speed_mps" value="$(arg route_max_speed_mps)"/>
    <param name="route_max_step_m" value="$(arg route_max_step_m)"/>
    <param name="transform_timeout" value="$(arg transform_timeout)"/>
    <param name="goal_topic" value="/navigation/dsv/next_goal"/>
    <param name="map_topic" value="/navigation/occupancy_grid_2d"/>
    <param name="cmd_vel_topic" value="/cmd_vel"/>
    <param name="stop_signal_topic" value="/navigation/stop_exploring"/>
    <param name="start_signal_topic" value="/navigation/start_exploring"/>
    <param name="minimal_map_validation" value="$(arg minimal_map_validation)"/>
    <param name="stop_after_map_updates" value="$(arg stop_after_map_updates)"/>
  </node>
</launch>
